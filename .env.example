# Supabase - App (read-only, safe to embed in client)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase - Server-side (seed scripts + sync pipeline)
# Required for writes after RLS lockdown migration.
# Get from: Supabase Dashboard > Settings > API > service_role key
# NEVER commit this key or expose it in client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Monetization (RevenueCat already wired in services/subscription.ts)
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Paywall Subscribe/Restore UI (set to 0 to hide purchase buttons)
# EXPO_PUBLIC_PAYWALL_ENABLED=1
# Dismissible sports-ad placeholder only. Never loads AdMob. Leave unset/off.
# EXPO_PUBLIC_SHOW_AD_SLOT=0

# Firebase (analytics)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
