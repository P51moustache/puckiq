# Supabase - App (read-only, safe to embed in client)
# Optional in 3.0: powers sign-in + team backup only. The coach runs on public NHL data.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase - Server-side (seed scripts + sync pipeline)
# Required for writes after RLS lockdown migration.
# Get from: Supabase Dashboard > Settings > API > service_role key
# NEVER commit this key or expose it in client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Monetization — RevenueCat, entitlement "pro", current offering with $rc_annual + $rc_monthly packages
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Paywall is ON by default. Set to 0 to hide purchase buttons (e.g. before store products are approved).
# EXPO_PUBLIC_PAYWALL_ENABLED=0
# ISO date the App Store price changed from $1.99 to Free. Anyone whose original app
# purchase is earlier keeps Pro for free. REQUIRED for the freemium release build.
# EXPO_PUBLIC_FREEMIUM_CUTOVER=2026-10-01
# Optional: when grandfathered Pro ends (e.g. end of the 2026-27 season). Unset = never.
# EXPO_PUBLIC_LEGACY_PRO_UNTIL=2027-06-30
# Local testing only (ignored outside __DEV__): unlock Pro without a store.
# EXPO_PUBLIC_DEV_PRO=1

# Links Apple requires near subscription purchases / in Settings
# Defaults point at site/ on GitHub Pages and zlce.app@gmail.com; override only if they move.
# EXPO_PUBLIC_PRIVACY_URL=https://p51moustache.github.io/puckiq/privacy.html
# EXPO_PUBLIC_SUPPORT_URL=https://p51moustache.github.io/puckiq/support.html
# EXPO_PUBLIC_TERMS_URL=   (defaults to Apple's standard EULA)
# EXPO_PUBLIC_SUPPORT_EMAIL=zlce.app@gmail.com

# Product analytics (iOS/Android) → PostHog project API key. Anonymous: random install ID,
# no account ID/email/roster. Unset = events stay on the device. EU project? set the host.
# EXPO_PUBLIC_POSTHOG_KEY=phc_...
# EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Firebase (web analytics only)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
